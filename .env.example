# my-agent 环境变量样例:cp .env.example .env 后按需修改
# 启动方式之一:export $(grep -v '^#' .env | xargs) && java -jar my-agent.jar

# --- 数据库(启动时自动建表,库需已存在) ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=myagent
PG_USER=postgres
PG_PASSWORD=postgres

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- 模型(OpenAI 兼容协议) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat
# 演示模式:无需 Key 跑通全链路;接真实模型时置 false
LLM_MOCK=true

# --- 服务 ---
# SERVER_PORT=8070
